{
  "manifest_version": 3,
  "name": "Séneca — Escudo político",
  "version": "1.0.0",
  "description": "Detecta políticos mexicanos en cualquier página web y muestra su expediente verificado. El antídoto al algoritmo.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}