{
    "manifest_version": 3,
    "name": "Séneca — Escudo político",
    "version": "1.0.0",
    "description": "Detecta políticos mexicanos en cualquier página web y muestra su expediente verificado. El antídoto al algoritmo.",
    "permissions": [
      "activeTab",
      "storage"
    ],
    "host_permissions": [
      "https://*.facebook.com/*",
      "https://*.twitter.com/*",
      "https://*.x.com/*",
      "https://*.instagram.com/*",
      "https://*.whatsapp.com/*",
      "https://*.youtube.com/*",
      "https://*/*"
    ],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["overlay.css"],
        "run_at": "document_idle"
      }
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
    "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }